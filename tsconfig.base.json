{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["packages/shared/src/*", "packages/shared/*"],
      "@supabase/*": ["packages/supabase/src/*"],
      "@web/*": ["apps/web/src/*"],
      "@mobile/*": ["apps/mobile/src/*"]
    }
  }
}
